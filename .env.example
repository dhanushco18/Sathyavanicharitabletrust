# ==============================================================================
# Sathiyavani Charitable Trust — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secret keys, service role tokens, or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD CONFIGURATION (Optional in local evaluation mode)
# ------------------------------------------------------------------------------
# When these two values are provided, the application automatically connects to
# your live Supabase PostgreSQL, Supabase Auth, and Supabase Storage instances.
# When left empty, the application runs seamlessly in dual-mode with a seeded local repository.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here

# Server-only service role key (NEVER expose with NEXT_PUBLIC_ prefix)
# Used exclusively for privileged administrative tasks, migrations, and backend workers
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. LOCAL EVALUATION & SECURITY OVERRIDES
# ------------------------------------------------------------------------------
# Fallback administrative password for local developer evaluation when cloud auth is offline
# Default in development: TrustAdmin#2026
ADMIN_DEV_PASSWORD=TrustAdmin#2026

# Session encryption salt for local cookie encoding
ADMIN_SESSION_SECRET=your-random-32-char-session-secret-here

# ------------------------------------------------------------------------------
# 3. PRODUCTION HOSTING & METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sathiyavanitrust.netlify.app
